database:
  path: archivio.db

server:
  host: 0.0.0.0
  port: 8000

office:
  name: ""
  language: de

scheduler:
  # Tägliche automatische Neu-Indexierung. 22:00 als Standard, da die meisten Büros um
  # diese Zeit nicht mehr aktiv arbeiten -- bei Bedarf in den Einstellungen anpassen
  # oder leer lassen zum Deaktivieren.
  scan_time: "22:00"

scanner:
  base_folders: []
  workers: 2  # Parallele Extraktions-Threads (1 = sequenziell, 2–4 empfohlen)
  supported_extensions:
    # Textextraktion
    - .pdf
    - .xlsx
    - .eml
    - .txt
    - .rtf
    - .doc
    - .docx
    - .dotx
    # Nur Metadaten / Dateiname
    - .dwg
    - .dxf
    - .pln
    - .vwx
    - .ifc
    - .rvt
    - .skp
    - .3dm
    - .nwd
    - .psd
    - .ai
    - .indd
    - .mp4
    - .mov
    - .zip
  excluded_folders: []
  hash_algorithm: sha256
  batch_size: 100

mail_accounts: []

# Rubrica-Integration: spiegelt beim Mail-Scan den vollen Mailtext (inkl. Signatur, die
# Archivio selbst für die Suche abschneidet) in eine zweite, separate SQLite-Datei, die
# Rubrica danebenliest. Siehe PROJEKT_STATUS.md "Rubrica-Integration".
rubrica:
  enabled: false
  db_path: ""   # leer = Standard: gleiches Verzeichnis wie archivio.db, Datei "rubrica.db"

logging:
  level: INFO

# Datei-Drop aufs Menüleisten-Icon: Namensmuster fuer den Umbenennungs-Vorschlag.
# Platzhalter {projektnummer}/{dateiname}/{datum} (JJMMTT), siehe Einstellungen-Seite.
upload:
  filename_template: "{dateiname}"

# Lizenzsystem: aktuell inaktiv (siehe scanner/license.py::LICENSE_UI_ENABLED),
# das Feld existiert bereits, damit spaeter nichts am Kernsystem nachgeruestet
# werden muss.
license:
  key: ""

projects: []

ablage:
  # Datei-Ablage mit Vorschlag (Drop aufs Menüleisten-Symbol); Einstellungen → Ablage-Struktur
  musterordner: ""               # Vorlage-Struktur (leer = aus den Projekten ableiten); der Musterordner ist nie ein Ziel
  lernen_ab_projektnummer:       # nur Projekte ab dieser Nummer lernen mit (leer = alle; Strut: 184)
  # archiv_labels: [archiv, alt, old, ueberholt]   # Ordner, die als Archiv gelten (normalisierte Namen ohne Ordnungspräfix)
  # projektnummer_regex: '^\s*(\d+)(?!\d)'        # Projektnummer im Projekt-NAMEN
  # dateiname_projektnummer: '\d{3}'               # Projektnummer als ganzes Wort im Dateinamen (nach einem Datum oder zuerst)
  # woerterbuch:                                   # Ergänzung zu config/ablage_woerterbuch.yaml (ersetzt nie)
  #   doktyp: {submission: [subm]}
  #   fachplaner: {bauingenieur: [tragwerksplaner]}
  # Stellschrauben der Engine. Die Standardwerte sind an der Strut-Sicherung gemessen (planung/datei-drop-ablage_messung-nachtrag-1.md);
  # nicht ohne Daten aus dem Alltag (ablage_log) verändern.
  # schwelle_sicher: 0.95          # ab dieser Summe gilt ein Ordner im Baum als „sicher bis hier"
  # projekt_sicher: 0.60           # ab dieser Wahrscheinlichkeit gilt das Projekt als erkannt
  # temperatur: 3.0
  # vorgaenger_bonus: 0.0          # Bonus für Ordner mit gleichnamiger früherer Datei (bei Strut gemessen: jeder Bonus schadet)
